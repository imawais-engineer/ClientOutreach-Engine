# --- Secrets -------------------------------------------------------------
# Never commit real credentials. .env.example is the only env file in git.
.env
.env.*
!.env.example
.env.local
.env.bak*
*.pem
*.key
credentials
credentials.json
service-account*.json

# --- Python --------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/

# --- Generated run data --------------------------------------------------
# Provider exports and per-run outputs are data dumps, not source.
output/*
!output/.gitkeep
raw_leads/*
!raw_leads/.gitkeep

# Crawled HTML is regenerated by the profile step
profile/raw_html/*
!profile/raw_html/.gitkeep
profile/persona.json

# --- Lives with the dashboard, not the engine ----------------------------
config/ui.json

# --- Local agent / tool scaffolding --------------------------------------
.agents/
.claude/
.freebuff/
skills-lock.json
AGENTS.md

# --- OS ------------------------------------------------------------------
.DS_Store
Thumbs.db
