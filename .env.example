# ClientOutreach engine — environment template.
#
# Copy to .env and fill in what you need:
#     cp .env.example .env
#
# Every layer below fails closed. A layer with no key is skipped, never
# faked: the run continues with the layers that are configured and reports
# the ones it could not use. Nothing here is sent anywhere except the
# provider or dashboard you name.
#
# No real key belongs in this file. .env is gitignored; this template is not.

# =========================================================================
# Layer 1 — Google Maps business discovery (pipeline/maps.py)
# =========================================================================
# Required for --source google_maps. Without it the Maps layer is skipped and
# the run reports "APIFY_TOKEN is not set". Apify charges per place scraped,
# so this layer is never part of a default run.
APIFY_TOKEN=your-apify-api-token

# Optional: pin a different Google Places actor. Blank uses the default actor
# named in pipeline/maps.py.
APIFY_MAPS_ACTOR=

# =========================================================================
# Layer 2 — Job boards (pipeline/sources.py -> pipeline/discover.py)
# =========================================================================
# No key required. RemoteOK, Remotive and We Work Remotely are public feeds.
# Nothing to configure; the layer is on whenever --source job_boards runs.

# =========================================================================
# Layer 3 — Social signals (pipeline/sources.py)
# =========================================================================
# Required for --source social. Without it the layer logs
# "SOCIALCRAWL_API_KEY not set" and returns no candidates.
SOCIALCRAWL_API_KEY=your-socialcrawl-api-key

# Optional: provider base URL. Defaults to the public SocialCrawl host.
SOCIALCRAWL_BASE_URL=https://www.socialcrawl.dev

# Optional: how many search queries one run may spend. Each query costs
# provider credits. Blank means "all queries in the source spec".
SOCIALCRAWL_MAX_QUERIES=

# =========================================================================
# Layers 4-9 — websites, directories, referrals, freelance, startups,
#              competitors
# =========================================================================
# No live adapter yet, so no key exists for them. They read a provider export
# instead:
#     python3 -m pipeline.run --source freelance --raw path/to/export.json
# Add a key here only after an adapter for that source is written.

# =========================================================================
# Dashboard push (pipeline/push.py) and follow-up review (pipeline/followups.py)
# =========================================================================
# Both variables are required for either one. Without them the engine still
# discovers and writes output/<source>_<date>.json, and says it skipped the
# push. DASHBOARD_API_SECRET is the same value the dashboard holds as
# API_SECRET and is sent as the x-api-secret header.
DASHBOARD_URL=https://your-dashboard.example.com
DASHBOARD_API_SECRET=change-me

# =========================================================================
# Tuning
# =========================================================================
# Relevance floor for the keyword gate (default 2). Raise it to admit fewer,
# more on-topic leads; it cannot go below 1.
MIN_RELEVANCE_SCORE=2

# Note: the source's scoring weights, the recency window and the capability
# list live in config.json / config/brain.json / config/sources/*.json, not
# in the environment, so a run is reproducible from the repo alone.
